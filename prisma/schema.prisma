// SQLite for local development. For production change provider to "postgresql".
// String columns are used instead of enums so the schema works on both.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

/// Every person we know about: registered customers, guest buyers, newsletter
/// leads and admins. This is the CRM's core record.
model User {
  id               String    @id @default(cuid())
  email            String    @unique
  name             String?
  phone            String?
  passwordHash     String?
  role             String    @default("CUSTOMER") // CUSTOMER | ADMIN
  /// LEAD | CUSTOMER | VIP | AT_RISK | CHURNED
  crmStatus        String    @default("LEAD")
  /// Comma-separated free-form tags, e.g. "wholesale,athlete"
  tags             String    @default("")
  source           String    @default("website") // website | checkout | newsletter | contact | stock_alert | admin
  marketingOptIn   Boolean   @default(false)
  stripeCustomerId String?   @unique
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  lastSeenAt       DateTime?

  addresses     Address[]
  orders        Order[]
  subscriptions Subscription[]
  notes         CustomerNote[]   @relation("NoteCustomer")
  authoredNotes CustomerNote[]   @relation("NoteAuthor")
  events        Event[]
  messages      ContactMessage[]
}

model Address {
  id        String  @id @default(cuid())
  userId    String
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  line1     String
  line2     String?
  city      String
  postcode  String
  country   String  @default("GB")
  phone     String?
  isDefault Boolean @default(false)
}

model Category {
  id          String    @id @default(cuid())
  slug        String    @unique
  name        String
  description String?
  position    Int       @default(0)
  products    Product[]
}

model Product {
  id                      String    @id @default(cuid())
  slug                    String    @unique
  legacyHandle            String?   @unique
  title                   String
  brand                   String
  categoryId              String?
  category                Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  /// Comma-separated goal/function tags, e.g. "Brain,Detox,Vegan"
  tags                    String    @default("")
  descriptionHtml         String    @default("")
  status                  String    @default("ACTIVE") // ACTIVE | DRAFT | ARCHIVED
  featured                Boolean   @default(false)
  subscribable            Boolean   @default(true)
  subscriptionDiscountPct Int       @default(10)
  seoTitle                String?
  seoDescription          String?
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt

  images     ProductImage[]
  variants   Variant[]
  orderItems OrderItem[]
  events     Event[]
}

model ProductImage {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  url       String
  alt       String  @default("")
  position  Int     @default(0)
}

model Variant {
  id             String  @id @default(cuid())
  productId      String
  product        Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  title          String  @default("Default")
  sku            String?
  pricePence     Int
  compareAtPence Int?
  stock          Int     @default(0)
  position       Int     @default(0)

  orderItems        OrderItem[]
  subscriptionItems SubscriptionItem[]
  stockAlerts       StockAlert[]
}

model Order {
  id                    Int           @id @default(autoincrement())
  userId                String?
  user                  User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  email                 String
  /// PENDING | PAID | FULFILLED | SHIPPED | DELIVERED | CANCELLED | REFUNDED
  status                String        @default("PENDING")
  subtotalPence         Int
  discountPence         Int           @default(0)
  shippingPence         Int           @default(0)
  totalPence            Int
  discountCode          String?
  shippingMethod        String        @default("STANDARD")
  shipName              String
  shipLine1             String
  shipLine2             String?
  shipCity              String
  shipPostcode          String
  shipCountry           String        @default("GB")
  shipPhone             String?
  trackingNumber        String?
  stripeSessionId       String?       @unique
  stripePaymentIntentId String?
  /// Set when this order was generated by a subscription renewal
  subscriptionId        String?
  subscription          Subscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)
  isRenewal             Boolean       @default(false)
  /// Delivery interval chosen at checkout for the subscribe items
  subscriptionInterval  Int?
  createdAt             DateTime      @default(now())
  paidAt                DateTime?

  items OrderItem[]
}

model OrderItem {
  id             String   @id @default(cuid())
  orderId        Int
  order          Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId      String?
  product        Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  variantId      String?
  variant        Variant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  title          String
  variantTitle   String
  imageUrl       String?
  unitPence      Int
  quantity       Int
  isSubscription Boolean  @default(false)
}

model Subscription {
  id                   String    @id @default(cuid())
  userId               String
  user                 User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// ACTIVE | PAUSED | PAST_DUE | CANCELLED
  status               String    @default("ACTIVE")
  intervalMonths       Int       @default(1)
  discountPct          Int       @default(10)
  nextChargeAt         DateTime
  stripeSubscriptionId String?   @unique
  shipName             String
  shipLine1            String
  shipLine2            String?
  shipCity             String
  shipPostcode         String
  shipCountry          String    @default("GB")
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
  cancelledAt          DateTime?
  cancelReason         String?

  items  SubscriptionItem[]
  orders Order[]
}

model SubscriptionItem {
  id             String       @id @default(cuid())
  subscriptionId String
  subscription   Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  variantId      String
  variant        Variant      @relation(fields: [variantId], references: [id], onDelete: Cascade)
  quantity       Int          @default(1)
  /// Price per unit after the subscription discount
  unitPence      Int
}

/// Analytics events: page_view, product_view, add_to_cart, checkout_started,
/// order_completed, subscription_started, subscription_cancelled, search, signup
model Event {
  id         String   @id @default(cuid())
  type       String
  visitorId  String?
  userId     String?
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  path       String?
  referrer   String?
  productId  String?
  product    Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  valuePence Int?
  meta       String?
  createdAt  DateTime @default(now())

  @@index([createdAt])
  @@index([type, createdAt])
  @@index([userId])
}

model CustomerNote {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation("NoteCustomer", fields: [userId], references: [id], onDelete: Cascade)
  authorId  String?
  author    User?    @relation("NoteAuthor", fields: [authorId], references: [id], onDelete: SetNull)
  body      String
  createdAt DateTime @default(now())
}

model ContactMessage {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  name      String
  email     String
  message   String
  status    String   @default("OPEN") // OPEN | CLOSED
  createdAt DateTime @default(now())
}

model StockAlert {
  id         String    @id @default(cuid())
  email      String
  variantId  String
  variant    Variant   @relation(fields: [variantId], references: [id], onDelete: Cascade)
  createdAt  DateTime  @default(now())
  notifiedAt DateTime?

  @@unique([email, variantId])
}

model DiscountCode {
  id               String    @id @default(cuid())
  code             String    @unique
  type             String    @default("PERCENT") // PERCENT | FIXED
  /// Percent (e.g. 10) or pence (e.g. 500) depending on type
  value            Int
  minSubtotalPence Int       @default(0)
  maxUses          Int?
  usageCount       Int       @default(0)
  active           Boolean   @default(true)
  expiresAt        DateTime?
  createdAt        DateTime  @default(now())
}

model BlogPost {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  excerpt     String   @default("")
  html        String
  publishedAt DateTime @default(now())
}

model Page {
  id    String @id @default(cuid())
  slug  String @unique
  title String
  html  String
}
