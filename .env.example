# Database — SQLite for local dev. For production switch the provider in
# prisma/schema.prisma to "postgresql" and point this at your Postgres URL.
DATABASE_URL="file:./dev.db"

# Long random string used to sign session cookies (openssl rand -base64 32)
AUTH_SECRET="change-me"

# Public URL of the site (used for Stripe redirect URLs)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Stripe — leave blank to run checkout in demo mode (orders are marked paid
# immediately, no card is charged).
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# First admin account created by the seed script
ADMIN_EMAIL="admin@red23.co.uk"
ADMIN_PASSWORD="change-me-admin"
